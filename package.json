{
  "name": "myarena-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently -k -n server,web \"npm run dev -w @myarena/server\" \"npm run dev -w @myarena/web\"",
    "build:shared": "npm run build -w @myarena/protocol && npm run build -w @myarena/game-sdk",
    "build": "npm run build:shared && npm run build -w @myarena/web && npm run build -w @myarena/server && npm run build -w @myarena/load",
    "start": "npm run start -w @myarena/server",
    "pretest": "npm run build:shared",
    "test": "npm run test:unit --workspaces --if-present",
    "pretest:integration": "npm run build:shared",
    "test:integration": "npm run test:integration -w @myarena/server",
    "pretest:contract": "npm run build:shared",
    "test:contract": "npm run test:contract -w @myarena/server",
    "test:e2e": "npm run test:e2e -w @myarena/web",
    "load": "npm run load -w @myarena/load --",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
